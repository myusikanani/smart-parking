# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/parking-system

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (Gmail app password; QR codes are emailed on booking)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# QR / gate rules
QR_EXPIRY_MINUTES=15
GRACE_PERIOD_MINUTES=15

# Flat Rs/hour overstay penalty override; unset = 1.5x the slot's hourly rate
# OVERSTAY_RATE=50

# CORS allowlist (exact origins, comma-separated). Defaults to localhost:5173/4173 if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay TEST MODE keys - https://dashboard.razorpay.com/app/keys (Test Mode toggle)
# Leave BOTH empty to run in simulation mode (payments auto-confirm, no real charges)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
